generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

enum VisitStatus {
  EXPECTED
  AWAITING_APPROVAL
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  DENIED
}

enum NotificationChannel {
  EMAIL
  SLACK
}

enum NotificationStatus {
  SENT
  FAILED
  SKIPPED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  REMOTE
  LEAVE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum SurveyTaskStatus {
  TODO
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
}

enum FieldReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model User {
  id                    String         @id @default(cuid())
  employeeId            String?        @unique
  email                 String         @unique
  slackEmail            String?
  name                  String
  passwordHash          String
  phone                 String?
  photoUrl              String?        @db.Text
  jobTitle              String?
  officeLocation        String?
  dateEmployed          DateTime?
  emergencyContactName  String?
  emergencyContactPhone String?
  status                UserStatus     @default(ACTIVE)
  failedLoginAttempts   Int            @default(0)
  lockoutUntil          DateTime?
  lastLoginAt           DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  departmentId          String?
  managerId             String?
  department            Department?    @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)
  manager               User?          @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports               User[]         @relation("UserManager")
  roles                 UserRole[]
  roleChanges           RoleChange[]   @relation("RoleChangeUser")
  roleChangesMade       RoleChange[]   @relation("RoleChangeActor")
  headedDepartments     Department[]   @relation("DepartmentHead")
  hostedVisits          Visit[]        @relation("VisitHost")
  registeredVisits      Visit[]        @relation("VisitRegistrar")
  checkedInVisits       Visit[]        @relation("VisitCheckIn")
  checkedOutVisits      Visit[]        @relation("VisitCheckOut")
  approvedVisits        Visit[]        @relation("VisitApprover")
  correctedVisits       Visit[]        @relation("VisitCorrector")
  cancelledVisits       Visit[]        @relation("VisitCanceller")
  auditEvents           AuditEvent[]   @relation("AuditActor")
  attendance            Attendance[]   @relation("AttendanceUser")
  attendanceRecorded    Attendance[]   @relation("AttendanceRecorder")
  invoicesCreated       Invoice[]      @relation("InvoiceCreator")
  paymentsRecorded      Payment[]      @relation("PaymentRecorder")
  expensesRecorded      Expense[]      @relation("ExpenseRecorder")
  expensesApproved      Expense[]      @relation("ExpenseApprover")
  managedProjects       Project[]      @relation("ProjectManager")
  createdProjects       Project[]      @relation("ProjectCreator")
  assignedParcels       LandParcel[]   @relation("ParcelAssignee")
  surveyTasks           SurveyTask[]   @relation("TaskAssignee")
  createdTasks          SurveyTask[]   @relation("TaskCreator")
  approvedTasks         SurveyTask[]   @relation("TaskApprover")
  fieldReports          FieldReport[]  @relation("ReportAuthor")
  approvedReports       FieldReport[]  @relation("ReportApprover")
  uploadedAttachments   Attachment[]   @relation("AttachmentUploader")
  complianceOwned       ComplianceObligation[] @relation("ComplianceOwner")
  complianceFiled       ComplianceObligation[] @relation("ComplianceFiler")
}

model Department {
  id          String        @id @default(cuid())
  name        String        @unique
  description String?
  location    String?
  active      Boolean       @default(true)
  headId      String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  head        User?         @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  users       User[]        @relation("DepartmentMembers")
  visits      Visit[]
  meetingRooms MeetingRoom[]
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]
  changes     RoleChange[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  module      String
  action      String
  description String
  roles       RolePermission[]
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RoleChange {
  id        String   @id @default(cuid())
  userId    String
  roleId    String?
  roleKey   String
  action    String
  note      String?
  actorId   String?
  createdAt DateTime @default(now())
  user      User     @relation("RoleChangeUser", fields: [userId], references: [id], onDelete: Cascade)
  role      Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  actor     User?    @relation("RoleChangeActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([actorId, createdAt])
}

model Visitor {
  id                       String    @id @default(cuid())
  visitorId                String    @unique
  fullName                 String
  phone                    String
  email                    String?
  organization             String?
  photoUrl                 String?   @db.Text
  identificationType       String?
  identificationCiphertext String?
  consentAt                DateTime?
  consentVersion           String?
  notes                    String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  visits                   Visit[]

  @@index([fullName])
  @@index([phone])
  @@index([email])
}

model MeetingRoom {
  id        String   @id @default(cuid())
  name      String   @unique
  location  String?
  capacity  Int?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visits    Visit[]
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
}

model Visit {
  id                      String      @id @default(cuid())
  visitCode               String      @unique
  visitorId               String
  hostId                  String?
  departmentId            String?
  meetingRoomId           String?
  purpose                 String
  category                String
  appointmentReference    String?
  expectedArrival         DateTime?
  expectedCheckout        DateTime?
  expectedDurationMinutes Int?
  checkedInAt             DateTime?
  checkedOutAt            DateTime?
  hostNotifiedAt          DateTime?
  approvalNote            String?
  approvedById            String?
  approvedAt              DateTime?
  cancelledById           String?
  cancelledAt             DateTime?
  correctionReason        String?
  correctedById           String?
  correctedAt             DateTime?
  checkInNote             String?
  accessZones             String?
  status                  VisitStatus @default(EXPECTED)
  qrVersion               Int         @default(0)
  cardReturned            Boolean?
  cardReturnNote          String?
  notes                   String?
  registeredById          String
  checkedInById           String?
  checkedOutById          String?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
  visitor                 Visitor     @relation(fields: [visitorId], references: [id], onDelete: Restrict)
  host                    User?       @relation("VisitHost", fields: [hostId], references: [id], onDelete: SetNull)
  department              Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  meetingRoom             MeetingRoom? @relation(fields: [meetingRoomId], references: [id], onDelete: SetNull)
  registeredBy            User        @relation("VisitRegistrar", fields: [registeredById], references: [id], onDelete: Restrict)
  checkedInBy             User?       @relation("VisitCheckIn", fields: [checkedInById], references: [id], onDelete: SetNull)
  checkedOutBy            User?       @relation("VisitCheckOut", fields: [checkedOutById], references: [id], onDelete: SetNull)
  approvedBy              User?       @relation("VisitApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  cancelledBy             User?       @relation("VisitCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  correctedBy             User?       @relation("VisitCorrector", fields: [correctedById], references: [id], onDelete: SetNull)

  @@index([status, expectedArrival])
  @@index([status, expectedCheckout])
  @@index([visitorId, createdAt])
  @@index([hostId, expectedArrival])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model Setting {
  key         String   @id
  value       Json
  description String?
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model Notification {
  id         String              @id @default(cuid())
  channel    NotificationChannel
  status     NotificationStatus
  recipient  String
  subject    String
  template   String
  entityType String?
  entityId   String?
  error      String?
  actorId    String?
  createdAt  DateTime            @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

model Attendance {
  id           String           @id @default(cuid())
  userId       String
  date         DateTime         @db.Date
  checkInAt    DateTime?
  checkOutAt   DateTime?
  status       AttendanceStatus @default(PRESENT)
  note         String?
  recordedById String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  user         User             @relation("AttendanceUser", fields: [userId], references: [id], onDelete: Cascade)
  recordedBy   User?            @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([userId, date])
  @@index([date])
}

model Invoice {
  id            String        @id @default(cuid())
  number        String        @unique
  customerName  String
  customerEmail String?
  description   String
  amount        Decimal       @db.Decimal(14, 2)
  currency      String        @default("GHS")
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  paidAt        DateTime?
  createdById   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdBy     User          @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  payments      Payment[]

  @@index([status, issueDate])
}

model Payment {
  id            String   @id @default(cuid())
  invoiceId     String?
  reference     String?
  payerName     String
  amount        Decimal  @db.Decimal(14, 2)
  method        String   @default("CASH")
  receivedAt    DateTime @default(now())
  note          String?
  recordedById  String
  createdAt     DateTime @default(now())
  invoice       Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  recordedBy    User     @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([receivedAt])
}

model Expense {
  id            String        @id @default(cuid())
  category      String
  vendor        String?
  description   String
  amount        Decimal       @db.Decimal(14, 2)
  incurredAt    DateTime      @default(now())
  status        ExpenseStatus @default(PENDING)
  note          String?
  receiptUrl    String?       @db.Text
  approvedById  String?
  approvedAt    DateTime?
  recordedById  String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  recordedBy    User          @relation("ExpenseRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  approvedBy    User?         @relation("ExpenseApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([status, incurredAt])
}

model Project {
  id          String        @id @default(cuid())
  code        String        @unique
  name        String
  description String?
  location    String?
  status      ProjectStatus @default(PLANNED)
  startDate   DateTime?
  endDate     DateTime?
  managerId   String?
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  manager     User?         @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  createdBy   User          @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  parcels     LandParcel[]
  tasks       SurveyTask[]
  reports     FieldReport[]

  @@index([status])
}

model LandParcel {
  id            String       @id @default(cuid())
  projectId     String
  parcelCode    String
  size          Decimal?     @db.Decimal(12, 2)
  unit          String       @default("acres")
  location      String?
  latitude      Float?
  longitude     Float?
  status        String       @default("ACTIVE")
  notes         String?
  assignedToId  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo    User?        @relation("ParcelAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  tasks         SurveyTask[]
  reports       FieldReport[]

  @@unique([projectId, parcelCode])
  @@index([assignedToId])
}

model SurveyTask {
  id            String           @id @default(cuid())
  projectId     String
  parcelId      String?
  title         String
  description   String?
  status        SurveyTaskStatus @default(TODO)
  priority      String           @default("NORMAL")
  assignedToId  String?
  dueDate       DateTime?
  submittedAt   DateTime?
  approvedById  String?
  approvedAt    DateTime?
  reviewNote    String?
  createdById   String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parcel        LandParcel?      @relation(fields: [parcelId], references: [id], onDelete: SetNull)
  assignedTo    User?            @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy     User             @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy    User?            @relation("TaskApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  reports       FieldReport[]

  @@index([status, dueDate])
  @@index([assignedToId])
}

model FieldReport {
  id           String            @id @default(cuid())
  taskId       String
  projectId    String
  parcelId     String?
  authorId     String
  summary      String
  findings     String?
  coordinates  String?
  measurements String?
  status       FieldReportStatus @default(DRAFT)
  submittedAt  DateTime?
  approvedById String?
  approvedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  task         SurveyTask        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parcel       LandParcel?       @relation(fields: [parcelId], references: [id], onDelete: SetNull)
  author       User              @relation("ReportAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  approvedBy   User?             @relation("ReportApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([status, submittedAt])
}

model Attachment {
  id           String   @id @default(cuid())
  entityType   String
  entityId     String
  fileName     String
  mimeType     String
  size         Int
  data         String   @db.Text
  uploadedById String
  createdAt    DateTime @default(now())
  uploadedBy   User     @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
}

model ComplianceObligation {
  id          String    @id @default(cuid())
  catalogKey  String
  period      String
  title       String
  authority   String
  category    String
  statute     String?
  frequency   String
  dueDate     DateTime?
  status      String    @default("PENDING")
  reference   String?
  notes       String?   @db.Text
  evidenceUrl String?
  ownerId     String?
  filedAt     DateTime?
  filedById   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  owner       User?     @relation("ComplianceOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  filedBy     User?     @relation("ComplianceFiler", fields: [filedById], references: [id], onDelete: SetNull)

  @@unique([catalogKey, period])
  @@index([dueDate, status])
  @@index([category, status])
}
